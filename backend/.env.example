# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido por CORS (la URL del frontend)
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alertaoax
DB_USER=postgres
DB_PASSWORD=pon-aqui-tu-password-de-postgres

# Autenticación (JWT). Usa una cadena larga y aleatoria; no la compartas.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES=8h
