# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido por CORS (la URL del frontend)
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alertaoax
DB_USER=postgres
DB_PASSWORD=pon-aqui-tu-password-de-postgres

# Autenticación (JWT). Usa una cadena larga y aleatoria; no la compartas.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES=8h

# Dirección pública de la app (para los enlaces de los correos). Ej.: https://alertaoax.duckdns.org
APP_URL=http://localhost:5173

# Correo saliente para "¿Olvidaste tu contraseña?" (Gmail con contraseña de aplicación de 16 letras).
# Si lo dejas vacío, el enlace se escribe en la consola del servidor (útil en desarrollo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=AlertaOax <tu-cuenta@gmail.com>

# Acceso con Google (opcional). ID de cliente OAuth de Google Cloud Console.
GOOGLE_CLIENT_ID=

# Botón de contacto rápido (opcional). WhatsApp: solo dígitos con lada de país (México: 52 + 10 dígitos).
CONTACTO_WHATSAPP=
CONTACTO_CORREO=

# Solo desarrollo/Postman: el registro devuelve el código de verificación en la respuesta. NUNCA en producción.
CODIGO_PRUEBA=0
